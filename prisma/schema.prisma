generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  READY
  ERROR
}

enum ClipStatus {
  PROCESSING
  READY
  ERROR
}

enum TranscriptionStatus {
  QUEUED
  EXTRACTING
  TRANSCRIBING
  SAVING
  COMPLETED
  CANCELLED
  ERROR
}

enum ReferenceType {
  LOCAL_VIDEO
  YOUTUBE_LINK
}

enum ReferenceAnalysisStatus {
  QUEUED
  EXTRACTING
  TRANSCRIBING
  MEASURING
  SAVING
  COMPLETED
  CANCELLED
  ERROR
}

enum StyleFeatureSource {
  MEASURED
  ESTIMATED
  MANUAL
  UNAVAILABLE
}

enum GroundTruthCategory {
  KILL
  DEATH
  MULTI_KILL
  ROUND_WIN
  ROUND_LOSS
  MATCH_ENDING
  POSSIBLE_CLUTCH
  DEFUSER_PLANT
  DEFUSER_DISABLE
  HIGH_ACTION_GAMEPLAY
  LOUD_CREATOR_REACTION
  FUNNY_CONVERSATION
  RAGE_OR_FRUSTRATION
  FAIL_OR_MISTAKE
  EDUCATIONAL_EXPLANATION
  QUIET_OR_LOW_INTEREST
  MENU
  SCOREBOARD
  REPLAY
  SPECTATOR_SCREEN
  LOADING_SCREEN
  OTHER_INTERESTING
  OTHER_UNINTERESTING
}

enum BenchmarkDatasetSplit {
  DEVELOPMENT
  VERIFICATION
}

enum BenchmarkRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  CANCELLED
  ERROR
}

enum LocalAnalysisStatus {
  QUEUED
  RUNNING
  COMPLETED
  CANCELLED
  ERROR
}

enum DetectorRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  CANCELLED
  ERROR
  SKIPPED
}

enum DetectorCost {
  LOW
  MEDIUM
  HIGH
}

enum DetectorSourceSignal {
  VIDEO
  AUDIO
  CREATOR_MICROPHONE
  GAME_AUDIO
  TRANSCRIPT
  OCR
  TEMPLATE_MATCHING
  FRAME_DIFFERENCE
  MOTION
  IMPORTED_TELEMETRY
  COMBINED_EVIDENCE
}

enum DetectorEvidenceKind {
  SUPPORTING
  CONFLICTING
}

enum SignalAggregation {
  MAXIMUM
  MEAN
  MEDIAN
  PERCENTILE
  EVENT_PRESERVING
}

enum SignalCurveKind {
  SCENE_CHANGE_SCORE
  FRAME_DIFFERENCE
  ACTION_INTENSITY
  BRIGHTNESS
  BLACK_PIXEL_RATIO
  STATIC_SIMILARITY
  AUDIO_LOUDNESS
  AUDIO_PEAK
  SILENCE_STATE
  TRANSCRIPT_EVIDENCE_DENSITY
}

enum AudioTrackRole {
  CREATOR_MICROPHONE
  GAME_AUDIO
  MIXED_AUDIO
  UNKNOWN
}

enum TranscriptEvidenceCategory {
  SURPRISE
  EXCITEMENT
  LAUGHTER
  FRUSTRATION
  CELEBRATION
  TACTICAL_EXPLANATION
  KILL_RELATED_LANGUAGE
  DEATH_RELATED_LANGUAGE
  WIN_RELATED_LANGUAGE
  LOSS_RELATED_LANGUAGE
  CLUTCH_RELATED_LANGUAGE
  DEFUSER_RELATED_LANGUAGE
  MISTAKE_OR_FAIL_LANGUAGE
  STORY_SETUP
  STORY_PAYOFF
  DIRECT_AUDIENCE_ADDRESS
  QUESTION_OR_SUSPENSE_SETUP
  MAP_RELATED_LANGUAGE
  ROOM_OR_CALLOUT_LANGUAGE
}

enum TranscriptRuleSource {
  DEFAULT
  USER
  IMPORTED
}

enum CandidateReviewDecision {
  USEFUL
  NOT_USEFUL
  WRONG_EVENT
}

enum OcrRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  CANCELLED
  ERROR
}

enum TelemetryImportStatus {
  READY
  ERROR
}

enum TelemetryEventCategory {
  MATCH_START
  MATCH_END
  ROUND_START
  ROUND_END
  KILL
  DEATH
  DEFUSER_PLANTED
  DEFUSER_DISABLED
  SCORE_UPDATE
  UNKNOWN
}

enum MapKnowledgeSource {
  OFFICIAL
  MANUAL
  IMPORTED
  INFERRED
}

enum MapKnowledgeStatus {
  CURRENT
  POSSIBLY_OUTDATED
  HISTORICAL
  UNVERIFIED
}

enum MapLifecycleStatus {
  ACTIVE
  DUAL_FRONT_ONLY
  EVENT_ONLY
  TEMPORARILY_UNAVAILABLE
  LEGACY
  UNAVAILABLE
}

enum MapPlaylist {
  RANKED
  UNRANKED
  QUICK_MATCH
  TEAM_DEATHMATCH
  EVENT_ONLY
  DUAL_FRONT
}

enum MapPlaylistAvailability {
  ACTIVE
  TEMPORARILY_OUTSIDE
  UNAVAILABLE
  LEGACY
}

enum MapElementType {
  ROOM
  HALLWAY
  STAIR
  LADDER
  HATCH
  DOOR
  WINDOW
  EXTERIOR_ENTRY
  EXTERIOR_AREA
  SPAWN_LOCATION
  OBJECTIVE_ROOM
  OBJECTIVE_LOCATION
  CAMERA
  DRONE_ROUTE
  SOFT_WALL
  REINFORCEABLE_WALL
  INDESTRUCTIBLE_WALL
  SOFT_FLOOR
  SOFT_CEILING
  VERTICAL_SIGHTLINE
  COMMON_ROTATION
  COMMON_CALLOUT
  COMMON_PLAYER_ROUTE
  DEFAULT_PLANT_LOCATION
  DEFAULT_DEFENSIVE_POSITION
  COMMON_ATTACKER_ENTRY_ROUTE
  COMMON_FLANK_ROUTE
  COMMON_UTILITY_POSITION
  OPEN_PASSAGE
}

enum MapGeometryType {
  NONE
  POINT
  LINE
  POLYGON
  PATH
}

enum MapCalloutKind {
  OFFICIAL
  COMMUNITY
  PERSONAL
  IMPORTED
  UNVERIFIED
}

enum MapConnectionType {
  DOOR
  WINDOW
  BREACHABLE_WALL
  OPEN_PASSAGE
  STAIRCASE
  LADDER
  HATCH
  EXTERIOR_ENTRY
  VERTICAL_DESTRUCTION
}

enum MapSide {
  UNKNOWN
  ATTACK
  DEFENSE
}

enum BlueprintAssetKind {
  ORIGINAL_ZIP
  ORIGINAL_IMAGE
  PREVIEW_IMAGE
}

enum MapUpdateCheckStatus {
  READY_FOR_MANUAL_REVIEW
  REVIEWED_NO_CHANGE
  CHANGES_FOUND
  CANCELLED
}

model Project {
  id                     String                    @id @default(cuid())
  name                   String
  status                 ProjectStatus             @default(READY)
  originalFilename       String
  sourceRelativePath     String                    @unique
  mimeType               String
  fileSizeBytes          BigInt
  durationSeconds        Float
  width                  Int
  height                 Int
  frameRate              Float
  errorMessage           String?
  videoFingerprintSha256 String?
  fingerprintComputedAt  DateTime?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  clips                  Clip[]
  contentDraft           ContentDraft?
  audioTracks            AudioTrack[]
  transcriptionJobs      TranscriptionJob[]
  groundTruthLabels      GroundTruthLabel[]
  benchmarkLinks         BenchmarkDatasetProject[]
  detectorConfigs        DetectorConfiguration[]
  analysisJobs           AnalysisJob[]
  calibrationProfiles    HudCalibrationProfile[]
  ocrRuns                OcrRun[]
  candidateMoments       CandidateMoment[]
  telemetryImports       TelemetryImport[]
  mapContext             ProjectMapContext?
  signalExplorer         SignalExplorerPreference?

  @@index([createdAt])
}

model AudioTrack {
  id                String             @id @default(cuid())
  projectId         String
  project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  streamIndex       Int
  codecName         String
  channels          Int
  channelLayout     String?
  language          String?
  title             String?
  isDefault         Boolean            @default(false)
  preferenceScore   Int                @default(0)
  preferenceReason  String?
  analysisRole      AudioTrackRole?
  roleConfirmedAt   DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  transcriptionJobs TranscriptionJob[]
  signalCurves      SignalCurve[]

  @@unique([projectId, streamIndex])
  @@index([projectId, streamIndex])
}

model TranscriptionJob {
  id                String              @id @default(cuid())
  projectId         String
  project           Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  audioTrackId      String
  audioTrack        AudioTrack          @relation(fields: [audioTrackId], references: [id], onDelete: Cascade)
  status            TranscriptionStatus @default(QUEUED)
  progress          Int                 @default(0)
  stage             String              @default("Waiting to start")
  provider          String              @default("whisper.cpp")
  modelName         String              @default("base.en")
  errorMessage      String?
  startedAt         DateTime?
  completedAt       DateTime?
  cancelRequestedAt DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  segments          TranscriptSegment[]

  @@index([projectId, createdAt])
  @@index([status])
}

model TranscriptSegment {
  id           String           @id @default(cuid())
  jobId        String
  job          TranscriptionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  segmentOrder Int
  startSeconds Float
  endSeconds   Float
  text         String
  originalText String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([jobId, segmentOrder])
  @@index([jobId, startSeconds])
}

model Clip {
  id              String     @id @default(cuid())
  projectId       String
  project         Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name            String
  status          ClipStatus @default(PROCESSING)
  startSeconds    Float
  endSeconds      Float
  durationSeconds Float
  relativePath    String?    @unique
  fileSizeBytes   BigInt?
  errorMessage    String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([projectId, createdAt])
}

model ContentDraft {
  id                  String   @id @default(cuid())
  projectId           String   @unique
  project             Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  voiceoverScript     String   @default("")
  openingHook         String   @default("")
  youtubeTitle        String   @default("")
  shortFormCaption    String   @default("")
  thumbnailText       String   @default("")
  editingInstructions String   @default("")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model ReferenceVideo {
  id                    String                   @id @default(cuid())
  referenceType         ReferenceType
  title                 String
  creatorName           String
  game                  String                   @default("Rainbow Six Siege")
  platform              String
  sourceType            String
  sourceUrl             String?
  youtubeVideoId        String?                  @unique
  contentCategory       String
  notes                 String?
  permissionConfirmed   Boolean                  @default(false)
  permissionConfirmedAt DateTime?
  originalFilename      String?
  sourceRelativePath    String?                  @unique
  mimeType              String?
  fileSizeBytes         BigInt?
  durationSeconds       Float?
  width                 Int?
  height                Int?
  frameRate             Float?
  thumbnailText         String?
  metadataSource        String                   @default("MANUAL")
  publicMetadataJson    String?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  audioTracks           ReferenceAudioTrack[]
  styleAnalyses         ReferenceStyleAnalysis[]
  profileLinks          StyleProfileReference[]

  @@index([referenceType, createdAt])
  @@index([contentCategory])
}

model ReferenceAudioTrack {
  id               String                   @id @default(cuid())
  referenceId      String
  reference        ReferenceVideo           @relation(fields: [referenceId], references: [id], onDelete: Cascade)
  streamIndex      Int
  codecName        String
  channels         Int
  channelLayout    String?
  language         String?
  title            String?
  isDefault        Boolean                  @default(false)
  preferenceScore  Int                      @default(0)
  preferenceReason String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  styleAnalyses    ReferenceStyleAnalysis[]

  @@unique([referenceId, streamIndex])
  @@index([referenceId, streamIndex])
}

model ReferenceStyleAnalysis {
  id                 String                       @id @default(cuid())
  referenceId        String
  reference          ReferenceVideo               @relation(fields: [referenceId], references: [id], onDelete: Cascade)
  audioTrackId       String?
  audioTrack         ReferenceAudioTrack?         @relation(fields: [audioTrackId], references: [id], onDelete: SetNull)
  status             ReferenceAnalysisStatus      @default(QUEUED)
  progress           Int                          @default(0)
  stage              String                       @default("Waiting to start")
  analyzerVersion    String                       @default("reference-style-v1")
  errorMessage       String?
  startedAt          DateTime?
  completedAt        DateTime?
  cancelRequestedAt  DateTime?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  transcriptSegments ReferenceTranscriptSegment[]
  features           ReferenceStyleFeature[]

  @@index([referenceId, createdAt])
  @@index([status])
}

model ReferenceTranscriptSegment {
  id           String                 @id @default(cuid())
  analysisId   String
  analysis     ReferenceStyleAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  segmentOrder Int
  startSeconds Float
  endSeconds   Float
  text         String
  originalText String
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@unique([analysisId, segmentOrder])
  @@index([analysisId, startSeconds])
}

model ReferenceStyleFeature {
  id                String                 @id @default(cuid())
  analysisId        String
  analysis          ReferenceStyleAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  key               String
  label             String
  valueJson         String
  originalValueJson String
  unit              String?
  confidence        Float
  evidence          String
  source            StyleFeatureSource
  detectorVersion   String
  manuallyCorrected Boolean                @default(false)
  correctionNote    String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@unique([analysisId, key])
  @@index([analysisId, key])
}

model CreatorStyleProfile {
  id                          String                  @id @default(cuid())
  name                        String
  description                 String?
  preferredVideoLengthSeconds Float?
  preferredHookLengthSeconds  Float?
  energyLevel                 Int                     @default(50)
  humorLevel                  Int                     @default(50)
  educationalLevel            Int                     @default(50)
  storytellingLevel           Int                     @default(50)
  setupAmount                 Int                     @default(50)
  voiceoverAmount             Int                     @default(50)
  liveAudioAmount             Int                     @default(50)
  captionDensity              Int                     @default(50)
  cutFrequency                Int                     @default(50)
  reactionEmphasis            Int                     @default(50)
  titleStyle                  String                  @default("Clear and original")
  thumbnailTextStyle          String                  @default("Short and readable")
  wordsToAvoid                String                  @default("")
  preferredPhrases            String                  @default("")
  profanityPreference         String                  @default("CENSOR")
  perspective                 String                  @default("FIRST_PERSON")
  profileVersion              String                  @default("structured-v1")
  createdAt                   DateTime                @default(now())
  updatedAt                   DateTime                @updatedAt
  referenceLinks              StyleProfileReference[]
  features                    StyleProfileFeature[]
  analysisJobs                AnalysisJob[]
  candidateMoments            CandidateMoment[]

  @@index([createdAt])
}

model StyleProfileReference {
  profileId   String
  referenceId String
  profile     CreatorStyleProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  reference   ReferenceVideo      @relation(fields: [referenceId], references: [id], onDelete: Cascade)
  createdAt   DateTime            @default(now())

  @@id([profileId, referenceId])
  @@index([referenceId])
}

model StyleProfileFeature {
  id                   String              @id @default(cuid())
  profileId            String
  profile              CreatorStyleProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  key                  String
  label                String
  valueJson            String
  confidence           Float
  reason               String
  sourceReferenceCount Int
  manuallyCorrected    Boolean             @default(false)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@unique([profileId, key])
  @@index([profileId, key])
}

model GroundTruthLabel {
  id              String              @id @default(cuid())
  projectId       String
  project         Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category        GroundTruthCategory
  startSeconds    Float
  peakSeconds     Float
  endSeconds      Float
  description     String?
  humanConfidence Float               @default(1)
  approved        Boolean             @default(false)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([projectId, startSeconds])
  @@index([projectId, category, approved])
}

model BenchmarkDataset {
  id            String                    @id @default(cuid())
  name          String
  description   String?
  schemaVersion String                    @default("r6-benchmark-dataset/v1")
  split         BenchmarkDatasetSplit     @default(DEVELOPMENT)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  projects      BenchmarkDatasetProject[]
  runs          BenchmarkRun[]

  @@index([split, createdAt])
}

model BenchmarkDatasetProject {
  datasetId                   String
  projectId                   String
  dataset                     BenchmarkDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  project                     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  videoFingerprint            String
  durationSeconds             Float
  width                       Int
  height                      Int
  recordingType               String           @default("UNSPECIFIED")
  labelSchemaVersion          String           @default("r6-creator-benchmark-labels/v1")
  fullyReviewedCategoriesJson String           @default("[]")
  humanReviewMinutes          Float?
  addedAt                     DateTime         @default(now())

  @@id([datasetId, projectId])
  @@index([projectId])
}

model BenchmarkRun {
  id                  String             @id @default(cuid())
  datasetId           String
  dataset             BenchmarkDataset   @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  analysisJobId       String?
  analysisJob         AnalysisJob?       @relation(fields: [analysisJobId], references: [id], onDelete: SetNull)
  status              BenchmarkRunStatus @default(QUEUED)
  matchingRuleVersion String             @default("temporal-category-v1")
  detectorSetVersion  String
  reportJson          String?
  errorMessage        String?
  startedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  metrics             BenchmarkMetric[]

  @@index([datasetId, createdAt])
  @@index([status])
}

model BenchmarkMetric {
  id                   String               @id @default(cuid())
  benchmarkRunId       String
  benchmarkRun         BenchmarkRun         @relation(fields: [benchmarkRunId], references: [id], onDelete: Cascade)
  category             GroundTruthCategory?
  sampleCount          Int
  truePositives        Int
  falsePositives       Int
  falseNegatives       Int
  precision            Float?
  recall               Float?
  f1                   Float?
  medianPeakError      Float?
  medianStartError     Float?
  medianEndError       Float?
  insufficientExamples Boolean              @default(true)
  extraMetricsJson     String               @default("{}")
  createdAt            DateTime             @default(now())

  @@index([benchmarkRunId, category])
}

model DetectorDefinition {
  id                  String                  @id @default(cuid())
  stableId            String
  name                String
  version             String
  description         String
  requiredInputsJson  String                  @default("[]")
  parameterSchemaJson String                  @default("{}")
  estimatedCost       DetectorCost            @default(LOW)
  implementationState String                  @default("ACTIVE")
  enabledByDefault    Boolean                 @default(true)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  configurations      DetectorConfiguration[]
  runs                DetectorRun[]

  @@unique([stableId, version])
  @@index([stableId])
}

model DetectorConfiguration {
  id                   String             @id @default(cuid())
  projectId            String
  project              Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  detectorDefinitionId String
  detectorDefinition   DetectorDefinition @relation(fields: [detectorDefinitionId], references: [id], onDelete: Cascade)
  enabled              Boolean
  parametersJson       String             @default("{}")
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@unique([projectId, detectorDefinitionId])
  @@index([projectId, enabled])
}

model AnalysisJob {
  id                      String                 @id @default(cuid())
  projectId               String
  project                 Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  calibrationProfileId    String?
  calibrationProfile      HudCalibrationProfile? @relation(fields: [calibrationProfileId], references: [id], onDelete: SetNull)
  styleProfileId          String?
  styleProfile            CreatorStyleProfile?   @relation(fields: [styleProfileId], references: [id], onDelete: SetNull)
  status                  LocalAnalysisStatus    @default(QUEUED)
  progress                Int                    @default(0)
  stage                   String                 @default("Waiting to start")
  analysisVersion         String                 @default("phase3b-framework-v1")
  detectorSetVersion      String
  currentDetectorStableId String?
  enabledDetectorCount    Int                    @default(0)
  completedDetectorCount  Int                    @default(0)
  failedDetectorCount     Int                    @default(0)
  estimatedWorkUnits      Int                    @default(0)
  temporaryDiskUsageBytes BigInt                 @default(0)
  warningsJson            String                 @default("[]")
  errorMessage            String?
  startedAt               DateTime?
  completedAt             DateTime?
  cancelRequestedAt       DateTime?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  detectorRuns            DetectorRun[]
  candidates              CandidateMoment[]
  benchmarkRuns           BenchmarkRun[]

  @@index([projectId, createdAt])
  @@index([status])
}

model DetectorRun {
  id                         String             @id @default(cuid())
  analysisJobId              String
  analysisJob                AnalysisJob        @relation(fields: [analysisJobId], references: [id], onDelete: Cascade)
  detectorDefinitionId       String
  detectorDefinition         DetectorDefinition @relation(fields: [detectorDefinitionId], references: [id], onDelete: Restrict)
  detectorStableId           String
  detectorVersion            String
  status                     DetectorRunStatus  @default(QUEUED)
  progress                   Int                @default(0)
  stage                      String             @default("Waiting")
  requiredInputsJson         String             @default("[]")
  parametersJson             String             @default("{}")
  processingDurationMs       Int?
  videoDurationSeconds       Float?
  processedSourceSeconds     Float?
  processingSpeedRatio       Float?
  peakMemoryBytes            BigInt?
  averageCpuPercent          Float?
  temporaryDiskUsageBytes    BigInt             @default(0)
  permanentDataBytes         BigInt             @default(0)
  rawMeasurementCount        Int                @default(0)
  aggregatedMeasurementCount Int                @default(0)
  generatedEventCount        Int                @default(0)
  curveChunkCount            Int                @default(0)
  warningsJson               String             @default("[]")
  errorMessage               String?
  startedAt                  DateTime?
  completedAt                DateTime?
  cancelRequestedAt          DateTime?
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt
  events                     DetectorEvent[]
  signalCurves               SignalCurve[]

  @@index([analysisJobId, createdAt])
  @@index([detectorStableId, detectorVersion])
  @@index([status])
}

model SignalCurve {
  id                    String               @id @default(cuid())
  detectorRunId         String
  detectorRun           DetectorRun          @relation(fields: [detectorRunId], references: [id], onDelete: Cascade)
  audioTrackId          String?
  audioTrack            AudioTrack?          @relation(fields: [audioTrackId], references: [id], onDelete: SetNull)
  stableId              String
  kind                  SignalCurveKind
  displayName           String
  unit                  String
  sourceSignal          DetectorSourceSignal
  sourceTrackRole       AudioTrackRole?
  sourceStreamIndex     Int?
  sampleIntervalSeconds Float
  aggregation           SignalAggregation
  configurationJson     String               @default("{}")
  statisticsJson        String               @default("{}")
  rawPointCount         Int
  storedPointCount      Int
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  chunks                SignalCurveChunk[]

  @@unique([detectorRunId, stableId])
  @@index([detectorRunId, kind])
  @@index([audioTrackId])
}

model SignalCurveChunk {
  id                       String      @id @default(cuid())
  signalCurveId            String
  signalCurve              SignalCurve @relation(fields: [signalCurveId], references: [id], onDelete: Cascade)
  chunkIndex               Int
  startSeconds             Float
  endSeconds               Float
  pointCount               Int
  encoding                 String      @default("gzip-json-v1")
  payload                  Bytes
  rawSizeBytes             Int
  compressedSizeBytes      Int
  minimumNormalizedValue   Float?
  maximumNormalizedValue   Float?
  maximumAbsoluteDeviation Float?
  createdAt                DateTime    @default(now())

  @@unique([signalCurveId, chunkIndex])
  @@index([signalCurveId, startSeconds, endSeconds])
}

model SignalExplorerPreference {
  id                  String   @id @default(cuid())
  projectId           String   @unique
  project             Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  visibleTracksJson   String   @default("[]")
  hiddenDetectorsJson String   @default("[]")
  minimumConfidence   Float    @default(0)
  zoomStartSeconds    Float?
  zoomEndSeconds      Float?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model TranscriptRule {
  id             String                     @id @default(cuid())
  stableId       String                     @unique
  name           String
  description    String
  category       TranscriptEvidenceCategory
  enabled        Boolean                    @default(true)
  isDefault      Boolean                    @default(false)
  currentVersion Int                        @default(1)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  versions       TranscriptRuleVersion[]

  @@index([category, enabled])
}

model TranscriptRuleVersion {
  id          String               @id @default(cuid())
  ruleId      String
  rule        TranscriptRule       @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  version     Int
  patternJson String
  confidence  Float                @default(0.6)
  source      TranscriptRuleSource @default(USER)
  changeNote  String?
  createdAt   DateTime             @default(now())

  @@unique([ruleId, version])
  @@index([ruleId, version])
}

model DetectorEvent {
  id                      String                   @id @default(cuid())
  detectorRunId           String
  detectorRun             DetectorRun              @relation(fields: [detectorRunId], references: [id], onDelete: Cascade)
  eventType               String                   @default("LEGACY_GROUND_TRUTH_EVENT")
  category                GroundTruthCategory?
  startSeconds            Float
  peakSeconds             Float
  endSeconds              Float
  confidence              Float
  supportingEvidenceJson  String                   @default("[]")
  conflictingEvidenceJson String                   @default("[]")
  sourceSignal            DetectorSourceSignal
  rawMeasurementsJson     String                   @default("{}")
  thresholdsJson          String                   @default("{}")
  debugArtifactsJson      String                   @default("[]")
  processingDurationMs    Int
  warningMessagesJson     String                   @default("[]")
  humanReviewStatus       String                   @default("UNREVIEWED")
  createdAt               DateTime                 @default(now())
  evidence                DetectorEvidence[]
  candidateLinks          CandidateDetectorEvent[]

  @@index([detectorRunId, startSeconds])
  @@index([eventType])
  @@index([category])
}

model DetectorEvidence {
  id                   String               @id @default(cuid())
  detectorEventId      String
  detectorEvent        DetectorEvent        @relation(fields: [detectorEventId], references: [id], onDelete: Cascade)
  kind                 DetectorEvidenceKind
  sourceSignal         DetectorSourceSignal
  summary              String
  timestampSeconds     Float?
  dataJson             String               @default("{}")
  artifactRelativePath String?
  containsPersonalData Boolean              @default(false)
  createdAt            DateTime             @default(now())

  @@index([detectorEventId, kind])
}

model HudCalibrationProfile {
  id             String        @id @default(cuid())
  projectId      String?
  project        Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  name           String
  description    String?
  game           String        @default("Rainbow Six Siege")
  baseWidth      Int
  baseHeight     Int
  profileVersion String        @default("hud-calibration-v1")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  regions        HudRegion[]
  analysisJobs   AnalysisJob[]

  @@index([projectId])
  @@index([baseWidth, baseHeight])
}

model HudRegion {
  id                   String                @id @default(cuid())
  calibrationProfileId String
  calibrationProfile   HudCalibrationProfile @relation(fields: [calibrationProfileId], references: [id], onDelete: Cascade)
  name                 String
  regionKind           String
  normalizedX          Float
  normalizedY          Float
  normalizedWidth      Float
  normalizedHeight     Float
  preprocessingJson    String                @default("{}")
  thresholdsJson       String                @default("{}")
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  ocrRuns              OcrRun[]

  @@unique([calibrationProfileId, name])
  @@index([calibrationProfileId, regionKind])
}

model OcrRun {
  id                String       @id @default(cuid())
  projectId         String
  project           Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  hudRegionId       String
  hudRegion         HudRegion    @relation(fields: [hudRegionId], references: [id], onDelete: Cascade)
  timestampSeconds  Float
  status            OcrRunStatus @default(QUEUED)
  engineId          String
  engineVersion     String
  preprocessingJson String       @default("{}")
  redactedText      String?
  confidence        Float?
  measurementsJson  String       @default("{}")
  errorMessage      String?
  createdAt         DateTime     @default(now())
  completedAt       DateTime?

  @@index([projectId, timestampSeconds])
  @@index([hudRegionId, createdAt])
}

model CandidateMoment {
  id                        String                   @id @default(cuid())
  projectId                 String
  project                   Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  analysisJobId             String
  analysisJob               AnalysisJob              @relation(fields: [analysisJobId], references: [id], onDelete: Cascade)
  styleProfileId            String?
  styleProfile              CreatorStyleProfile?     @relation(fields: [styleProfileId], references: [id], onDelete: SetNull)
  category                  GroundTruthCategory
  alternativeCategoriesJson String                   @default("[]")
  startSeconds              Float
  peakSeconds               Float
  endSeconds                Float
  eventConfidence           Float
  contentPotentialScore     Float
  styleSimilarity           Float?
  scoreBreakdownJson        String                   @default("{}")
  explanation               String
  missingEvidenceJson       String                   @default("[]")
  detectorVersionsJson      String                   @default("{}")
  note                      String?
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  detectorLinks             CandidateDetectorEvent[]
  reviews                   CandidateReviewLabel[]

  @@index([projectId, startSeconds])
  @@index([analysisJobId])
  @@index([category])
}

model CandidateDetectorEvent {
  candidateId     String
  detectorEventId String
  candidate       CandidateMoment @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  detectorEvent   DetectorEvent   @relation(fields: [detectorEventId], references: [id], onDelete: Cascade)
  role            String          @default("SUPPORTING")
  createdAt       DateTime        @default(now())

  @@id([candidateId, detectorEventId])
  @@index([detectorEventId])
}

model CandidateReviewLabel {
  id                    String                  @id @default(cuid())
  candidateId           String
  candidate             CandidateMoment         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  decision              CandidateReviewDecision
  correctedStartSeconds Float?
  correctedEndSeconds   Float?
  correctedCategory     GroundTruthCategory?
  note                  String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  @@index([candidateId, createdAt])
}

model TelemetryImport {
  id                    String                @id @default(cuid())
  projectId             String
  project               Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  schemaVersion         String
  recordingStartTime    DateTime?
  clockSource           String
  synchronizationOffset Float                 @default(0)
  eventSource           String
  sourceVersion         String
  status                TelemetryImportStatus @default(READY)
  errorMessage          String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  events                TelemetryEvent[]

  @@index([projectId, createdAt])
}

model TelemetryEvent {
  id                 String                 @id @default(cuid())
  telemetryImportId  String
  telemetryImport    TelemetryImport        @relation(fields: [telemetryImportId], references: [id], onDelete: Cascade)
  timestampSeconds   Float
  normalizedCategory TelemetryEventCategory
  rawPayloadJson     String                 @default("{}")
  createdAt          DateTime               @default(now())

  @@index([telemetryImportId, timestampSeconds])
}

model GameDataVersion {
  id               String              @id @default(cuid())
  stableId         String              @unique
  game             String              @default("Rainbow Six Siege")
  year             Int
  seasonName       String
  seasonNumber     Int
  releaseDate      DateTime
  verificationDate DateTime
  notes            String?
  sourceUrl        String
  sourceTitle      String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  mapVersions      MapVersion[]
  playlistStatuses MapPlaylistStatus[]
  updateChecks     MapUpdateCheck[]

  @@index([year, seasonNumber])
}

model SiegeMap {
  id                         String                @id @default(cuid())
  stableId                   String                @unique
  slug                       String                @unique
  name                       String
  officialDescription        String
  location                   String?
  releaseLabel               String
  releaseDate                DateTime?
  modernizationLabel         String?
  modernizationDate          DateTime?
  lifecycleStatus            MapLifecycleStatus    @default(ACTIVE)
  knowledgeStatus            MapKnowledgeStatus    @default(UNVERIFIED)
  sourceType                 MapKnowledgeSource    @default(OFFICIAL)
  officialSourceUrl          String
  officialSourceTitle        String
  retrievedAt                DateTime
  lastVerifiedAt             DateTime
  officialBlueprintAvailable Boolean               @default(false)
  officialBlueprintPageUrl   String?
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt
  aliases                    MapAlias[]
  versions                   MapVersion[]
  playlistStatuses           MapPlaylistStatus[]
  citations                  MapSourceCitation[]
  calloutPreference          MapCalloutPreference?
  projectContexts            ProjectMapContext[]

  @@index([name])
  @@index([knowledgeStatus])
}

model MapAlias {
  id             String             @id @default(cuid())
  mapId          String
  map            SiegeMap           @relation(fields: [mapId], references: [id], onDelete: Cascade)
  displayName    String
  normalizedName String
  calloutKind    MapCalloutKind     @default(UNVERIFIED)
  sourceType     MapKnowledgeSource @default(MANUAL)
  confidence     Float              @default(1)
  lastVerifiedAt DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([mapId, normalizedName])
  @@index([normalizedName])
}

model MapVersion {
  id                String              @id @default(cuid())
  stableId          String              @unique
  mapId             String
  map               SiegeMap            @relation(fields: [mapId], references: [id], onDelete: Cascade)
  gameDataVersionId String?
  gameDataVersion   GameDataVersion?    @relation(fields: [gameDataVersionId], references: [id], onDelete: SetNull)
  parentVersionId   String?
  parentVersion     MapVersion?         @relation("MapVersionHistory", fields: [parentVersionId], references: [id], onDelete: SetNull)
  childVersions     MapVersion[]        @relation("MapVersionHistory")
  versionKey        String
  versionName       String
  effectiveDate     DateTime?
  knowledgeStatus   MapKnowledgeStatus  @default(UNVERIFIED)
  sourceType        MapKnowledgeSource  @default(OFFICIAL)
  sourceUrl         String
  sourceTitle       String
  confidence        Float               @default(1)
  notes             String?
  lastVerifiedAt    DateTime
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  floors            MapFloor[]
  elements          MapElement[]
  connections       MapConnection[]
  bombSites         MapBombSitePair[]
  blueprintAssets   BlueprintAsset[]
  citations         MapSourceCitation[]
  editHistory       MapEditHistory[]
  projectContexts   ProjectMapContext[]

  @@unique([mapId, versionKey])
  @@index([mapId, knowledgeStatus])
}

model MapPlaylistStatus {
  id                String                  @id @default(cuid())
  mapId             String
  map               SiegeMap                @relation(fields: [mapId], references: [id], onDelete: Cascade)
  gameDataVersionId String
  gameDataVersion   GameDataVersion         @relation(fields: [gameDataVersionId], references: [id], onDelete: Cascade)
  playlist          MapPlaylist
  availability      MapPlaylistAvailability
  sourceType        MapKnowledgeSource      @default(OFFICIAL)
  sourceUrl         String
  sourceTitle       String
  notes             String?
  lastVerifiedAt    DateTime
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@unique([mapId, gameDataVersionId, playlist])
  @@index([playlist, availability])
}

model MapFloor {
  id              String              @id @default(cuid())
  stableId        String              @unique
  mapVersionId    String
  mapVersion      MapVersion          @relation(fields: [mapVersionId], references: [id], onDelete: Cascade)
  displayName     String
  shortName       String?
  sortOrder       Int
  elevation       Int                 @default(0)
  sourceType      MapKnowledgeSource  @default(MANUAL)
  confidence      Float               @default(1)
  notes           String?
  lastVerifiedAt  DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  elements        MapElement[]
  bombSites       MapBombSitePair[]
  blueprintAssets BlueprintAsset[]
  citations       MapSourceCitation[]

  @@unique([mapVersionId, displayName])
  @@index([mapVersionId, sortOrder])
}

model MapElement {
  id                      String               @id @default(cuid())
  stableId                String               @unique
  mapVersionId            String
  mapVersion              MapVersion           @relation(fields: [mapVersionId], references: [id], onDelete: Cascade)
  floorId                 String?
  floor                   MapFloor?            @relation(fields: [floorId], references: [id], onDelete: SetNull)
  elementType             MapElementType
  displayName             String
  canonicalCallout        String?
  calloutKind             MapCalloutKind       @default(UNVERIFIED)
  geometryType            MapGeometryType      @default(NONE)
  geometryJson            String               @default("[]")
  sourceType              MapKnowledgeSource   @default(MANUAL)
  confidence              Float                @default(1)
  notes                   String?
  commonAttackerApproach  String?
  commonDefenderHold      String?
  commonFlankRisk         String?
  captionName             String?
  voiceoverName           String?
  lastVerifiedAt          DateTime?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  aliases                 MapElementAlias[]
  outgoingConnections     MapConnection[]      @relation("MapConnectionFrom")
  incomingConnections     MapConnection[]      @relation("MapConnectionTo")
  bombSiteLinks           MapBombSiteElement[]
  citations               MapSourceCitation[]
  startingProjectContexts ProjectMapContext[]  @relation("ProjectStartingRoom")

  @@unique([mapVersionId, displayName, elementType])
  @@index([mapVersionId, elementType])
  @@index([floorId, elementType])
}

model MapElementAlias {
  id             String             @id @default(cuid())
  elementId      String
  element        MapElement         @relation(fields: [elementId], references: [id], onDelete: Cascade)
  displayName    String
  normalizedName String
  calloutKind    MapCalloutKind
  sourceType     MapKnowledgeSource @default(MANUAL)
  confidence     Float              @default(1)
  notes          String?
  lastVerifiedAt DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([elementId, normalizedName])
  @@index([normalizedName])
}

model MapConnection {
  id              String             @id @default(cuid())
  stableId        String             @unique
  mapVersionId    String
  mapVersion      MapVersion         @relation(fields: [mapVersionId], references: [id], onDelete: Cascade)
  fromElementId   String
  fromElement     MapElement         @relation("MapConnectionFrom", fields: [fromElementId], references: [id], onDelete: Cascade)
  toElementId     String
  toElement       MapElement         @relation("MapConnectionTo", fields: [toElementId], references: [id], onDelete: Cascade)
  connectionType  MapConnectionType
  isBidirectional Boolean            @default(true)
  traversable     Boolean            @default(true)
  destructible    Boolean            @default(false)
  floorChange     Boolean            @default(false)
  requiredAction  String?
  notes           String?
  sourceType      MapKnowledgeSource @default(MANUAL)
  confidence      Float              @default(1)
  lastVerifiedAt  DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([mapVersionId, fromElementId, toElementId, connectionType])
  @@index([fromElementId])
  @@index([toElementId])
}

model MapBombSitePair {
  id              String               @id @default(cuid())
  stableId        String               @unique
  mapVersionId    String
  mapVersion      MapVersion           @relation(fields: [mapVersionId], references: [id], onDelete: Cascade)
  floorId         String?
  floor           MapFloor?            @relation(fields: [floorId], references: [id], onDelete: SetNull)
  displayName     String
  siteAName       String
  siteBName       String
  tacticalNotes   String?
  sourceType      MapKnowledgeSource   @default(MANUAL)
  confidence      Float                @default(1)
  lastVerifiedAt  DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  elementLinks    MapBombSiteElement[]
  citations       MapSourceCitation[]
  projectContexts ProjectMapContext[]

  @@unique([mapVersionId, displayName])
  @@index([mapVersionId, floorId])
}

model MapBombSiteElement {
  id         String          @id @default(cuid())
  bombSiteId String
  bombSite   MapBombSitePair @relation(fields: [bombSiteId], references: [id], onDelete: Cascade)
  elementId  String
  element    MapElement      @relation(fields: [elementId], references: [id], onDelete: Cascade)
  role       String
  notes      String?
  createdAt  DateTime        @default(now())

  @@unique([bombSiteId, elementId, role])
  @@index([elementId])
}

model BlueprintAsset {
  id               String             @id @default(cuid())
  stableId         String             @unique
  mapVersionId     String
  mapVersion       MapVersion         @relation(fields: [mapVersionId], references: [id], onDelete: Cascade)
  floorId          String?
  floor            MapFloor?          @relation(fields: [floorId], references: [id], onDelete: SetNull)
  parentAssetId    String?
  parentAsset      BlueprintAsset?    @relation("BlueprintDerivatives", fields: [parentAssetId], references: [id], onDelete: Cascade)
  derivedAssets    BlueprintAsset[]   @relation("BlueprintDerivatives")
  assetKind        BlueprintAssetKind
  originalFileName String
  relativePath     String             @unique
  mimeType         String
  fileSizeBytes    BigInt
  sha256           String
  width            Int?
  height           Int?
  sourceType       MapKnowledgeSource @default(IMPORTED)
  sourceUrl        String?
  sourceTitle      String?
  notes            String?
  importedAt       DateTime           @default(now())
  lastVerifiedAt   DateTime?

  @@index([mapVersionId, assetKind])
  @@index([floorId])
}

model MapSourceCitation {
  id             String             @id @default(cuid())
  stableId       String             @unique
  mapId          String?
  map            SiegeMap?          @relation(fields: [mapId], references: [id], onDelete: Cascade)
  mapVersionId   String?
  mapVersion     MapVersion?        @relation(fields: [mapVersionId], references: [id], onDelete: Cascade)
  floorId        String?
  floor          MapFloor?          @relation(fields: [floorId], references: [id], onDelete: Cascade)
  elementId      String?
  element        MapElement?        @relation(fields: [elementId], references: [id], onDelete: Cascade)
  bombSiteId     String?
  bombSite       MapBombSitePair?   @relation(fields: [bombSiteId], references: [id], onDelete: Cascade)
  title          String
  url            String
  sourceType     MapKnowledgeSource @default(MANUAL)
  retrievedAt    DateTime
  lastVerifiedAt DateTime?
  notes          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([mapId])
  @@index([mapVersionId])
  @@index([elementId])
  @@index([bombSiteId])
}

model MapCalloutPreference {
  id            String         @id @default(cuid())
  mapId         String         @unique
  map           SiegeMap       @relation(fields: [mapId], references: [id], onDelete: Cascade)
  preferredKind MapCalloutKind @default(OFFICIAL)
  customNotes   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model ProjectMapContext {
  id                   String             @id @default(cuid())
  projectId            String             @unique
  project              Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mapId                String?
  map                  SiegeMap?          @relation(fields: [mapId], references: [id], onDelete: SetNull)
  mapVersionId         String?
  mapVersion           MapVersion?        @relation(fields: [mapVersionId], references: [id], onDelete: SetNull)
  bombSiteId           String?
  bombSite             MapBombSitePair?   @relation(fields: [bombSiteId], references: [id], onDelete: SetNull)
  side                 MapSide            @default(UNKNOWN)
  startingRoomId       String?
  startingRoom         MapElement?        @relation("ProjectStartingRoom", fields: [startingRoomId], references: [id], onDelete: SetNull)
  importantRoomIdsJson String             @default("[]")
  operator             String?
  roundResult          String?
  userConfirmed        Boolean            @default(false)
  confidence           Float              @default(1)
  sourceType           MapKnowledgeSource @default(MANUAL)
  notes                String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([mapId, mapVersionId])
}

model MapEditHistory {
  id             String     @id @default(cuid())
  mapVersionId   String
  mapVersion     MapVersion @relation(fields: [mapVersionId], references: [id], onDelete: Cascade)
  operation      String
  entityType     String
  entityStableId String
  beforeJson     String?
  afterJson      String?
  undoGroup      String
  revertedAt     DateTime?
  createdAt      DateTime   @default(now())

  @@index([mapVersionId, createdAt])
  @@index([undoGroup])
}

model MapUpdateCheck {
  id                String               @id @default(cuid())
  gameDataVersionId String
  gameDataVersion   GameDataVersion      @relation(fields: [gameDataVersionId], references: [id], onDelete: Cascade)
  status            MapUpdateCheckStatus @default(READY_FOR_MANUAL_REVIEW)
  sourceUrlsJson    String
  findingsJson      String               @default("[]")
  notes             String?
  requestedAt       DateTime             @default(now())
  completedAt       DateTime?

  @@index([gameDataVersionId, requestedAt])
}
