generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  READY
  ERROR
}

enum ClipStatus {
  PROCESSING
  READY
  ERROR
}

enum TranscriptionStatus {
  QUEUED
  EXTRACTING
  TRANSCRIBING
  SAVING
  COMPLETED
  CANCELLED
  ERROR
}

enum ReferenceType {
  LOCAL_VIDEO
  YOUTUBE_LINK
}

enum ReferenceAnalysisStatus {
  QUEUED
  EXTRACTING
  TRANSCRIBING
  MEASURING
  SAVING
  COMPLETED
  CANCELLED
  ERROR
}

enum StyleFeatureSource {
  MEASURED
  ESTIMATED
  MANUAL
  UNAVAILABLE
}

model Project {
  id                 String             @id @default(cuid())
  name               String
  status             ProjectStatus      @default(READY)
  originalFilename   String
  sourceRelativePath String             @unique
  mimeType           String
  fileSizeBytes      BigInt
  durationSeconds    Float
  width              Int
  height             Int
  frameRate          Float
  errorMessage       String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  clips              Clip[]
  contentDraft       ContentDraft?
  audioTracks        AudioTrack[]
  transcriptionJobs  TranscriptionJob[]

  @@index([createdAt])
}

model AudioTrack {
  id                String             @id @default(cuid())
  projectId         String
  project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  streamIndex       Int
  codecName         String
  channels          Int
  channelLayout     String?
  language          String?
  title             String?
  isDefault         Boolean            @default(false)
  preferenceScore   Int                @default(0)
  preferenceReason  String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  transcriptionJobs TranscriptionJob[]

  @@unique([projectId, streamIndex])
  @@index([projectId, streamIndex])
}

model TranscriptionJob {
  id                String              @id @default(cuid())
  projectId         String
  project           Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  audioTrackId      String
  audioTrack        AudioTrack          @relation(fields: [audioTrackId], references: [id], onDelete: Cascade)
  status            TranscriptionStatus @default(QUEUED)
  progress          Int                 @default(0)
  stage             String              @default("Waiting to start")
  provider          String              @default("whisper.cpp")
  modelName         String              @default("base.en")
  errorMessage      String?
  startedAt         DateTime?
  completedAt       DateTime?
  cancelRequestedAt DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  segments          TranscriptSegment[]

  @@index([projectId, createdAt])
  @@index([status])
}

model TranscriptSegment {
  id           String           @id @default(cuid())
  jobId        String
  job          TranscriptionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  segmentOrder Int
  startSeconds Float
  endSeconds   Float
  text         String
  originalText String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([jobId, segmentOrder])
  @@index([jobId, startSeconds])
}

model Clip {
  id              String     @id @default(cuid())
  projectId       String
  project         Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name            String
  status          ClipStatus @default(PROCESSING)
  startSeconds    Float
  endSeconds      Float
  durationSeconds Float
  relativePath    String?    @unique
  fileSizeBytes   BigInt?
  errorMessage    String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([projectId, createdAt])
}

model ContentDraft {
  id                  String   @id @default(cuid())
  projectId           String   @unique
  project             Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  voiceoverScript     String   @default("")
  openingHook         String   @default("")
  youtubeTitle        String   @default("")
  shortFormCaption    String   @default("")
  thumbnailText       String   @default("")
  editingInstructions String   @default("")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model ReferenceVideo {
  id                    String                   @id @default(cuid())
  referenceType         ReferenceType
  title                 String
  creatorName           String
  game                  String                   @default("Rainbow Six Siege")
  platform              String
  sourceType            String
  sourceUrl             String?
  youtubeVideoId        String?                  @unique
  contentCategory       String
  notes                 String?
  permissionConfirmed   Boolean                  @default(false)
  permissionConfirmedAt DateTime?
  originalFilename      String?
  sourceRelativePath    String?                  @unique
  mimeType              String?
  fileSizeBytes         BigInt?
  durationSeconds       Float?
  width                 Int?
  height                Int?
  frameRate             Float?
  thumbnailText         String?
  metadataSource        String                   @default("MANUAL")
  publicMetadataJson    String?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  audioTracks           ReferenceAudioTrack[]
  styleAnalyses         ReferenceStyleAnalysis[]
  profileLinks          StyleProfileReference[]

  @@index([referenceType, createdAt])
  @@index([contentCategory])
}

model ReferenceAudioTrack {
  id               String                   @id @default(cuid())
  referenceId      String
  reference        ReferenceVideo           @relation(fields: [referenceId], references: [id], onDelete: Cascade)
  streamIndex      Int
  codecName        String
  channels         Int
  channelLayout    String?
  language         String?
  title            String?
  isDefault        Boolean                  @default(false)
  preferenceScore  Int                      @default(0)
  preferenceReason String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  styleAnalyses    ReferenceStyleAnalysis[]

  @@unique([referenceId, streamIndex])
  @@index([referenceId, streamIndex])
}

model ReferenceStyleAnalysis {
  id                 String                       @id @default(cuid())
  referenceId        String
  reference          ReferenceVideo               @relation(fields: [referenceId], references: [id], onDelete: Cascade)
  audioTrackId       String?
  audioTrack         ReferenceAudioTrack?         @relation(fields: [audioTrackId], references: [id], onDelete: SetNull)
  status             ReferenceAnalysisStatus      @default(QUEUED)
  progress           Int                          @default(0)
  stage              String                       @default("Waiting to start")
  analyzerVersion    String                       @default("reference-style-v1")
  errorMessage       String?
  startedAt          DateTime?
  completedAt        DateTime?
  cancelRequestedAt  DateTime?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  transcriptSegments ReferenceTranscriptSegment[]
  features           ReferenceStyleFeature[]

  @@index([referenceId, createdAt])
  @@index([status])
}

model ReferenceTranscriptSegment {
  id           String                 @id @default(cuid())
  analysisId   String
  analysis     ReferenceStyleAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  segmentOrder Int
  startSeconds Float
  endSeconds   Float
  text         String
  originalText String
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@unique([analysisId, segmentOrder])
  @@index([analysisId, startSeconds])
}

model ReferenceStyleFeature {
  id                String                 @id @default(cuid())
  analysisId        String
  analysis          ReferenceStyleAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  key               String
  label             String
  valueJson         String
  originalValueJson String
  unit              String?
  confidence        Float
  evidence          String
  source            StyleFeatureSource
  detectorVersion   String
  manuallyCorrected Boolean                @default(false)
  correctionNote    String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@unique([analysisId, key])
  @@index([analysisId, key])
}

model CreatorStyleProfile {
  id                          String                  @id @default(cuid())
  name                        String
  description                 String?
  preferredVideoLengthSeconds Float?
  preferredHookLengthSeconds  Float?
  energyLevel                 Int                     @default(50)
  humorLevel                  Int                     @default(50)
  educationalLevel            Int                     @default(50)
  storytellingLevel           Int                     @default(50)
  setupAmount                 Int                     @default(50)
  voiceoverAmount             Int                     @default(50)
  liveAudioAmount             Int                     @default(50)
  captionDensity              Int                     @default(50)
  cutFrequency                Int                     @default(50)
  reactionEmphasis            Int                     @default(50)
  titleStyle                  String                  @default("Clear and original")
  thumbnailTextStyle          String                  @default("Short and readable")
  wordsToAvoid                String                  @default("")
  preferredPhrases            String                  @default("")
  profanityPreference         String                  @default("CENSOR")
  perspective                 String                  @default("FIRST_PERSON")
  profileVersion              String                  @default("structured-v1")
  createdAt                   DateTime                @default(now())
  updatedAt                   DateTime                @updatedAt
  referenceLinks              StyleProfileReference[]
  features                    StyleProfileFeature[]

  @@index([createdAt])
}

model StyleProfileReference {
  profileId   String
  referenceId String
  profile     CreatorStyleProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  reference   ReferenceVideo      @relation(fields: [referenceId], references: [id], onDelete: Cascade)
  createdAt   DateTime            @default(now())

  @@id([profileId, referenceId])
  @@index([referenceId])
}

model StyleProfileFeature {
  id                   String              @id @default(cuid())
  profileId            String
  profile              CreatorStyleProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  key                  String
  label                String
  valueJson            String
  confidence           Float
  reason               String
  sourceReferenceCount Int
  manuallyCorrected    Boolean             @default(false)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@unique([profileId, key])
  @@index([profileId, key])
}
