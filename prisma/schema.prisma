generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  READY
  ERROR
}

enum ClipStatus {
  PROCESSING
  READY
  ERROR
}

enum TranscriptionStatus {
  QUEUED
  EXTRACTING
  TRANSCRIBING
  SAVING
  COMPLETED
  CANCELLED
  ERROR
}

model Project {
  id                 String             @id @default(cuid())
  name               String
  status             ProjectStatus      @default(READY)
  originalFilename   String
  sourceRelativePath String             @unique
  mimeType           String
  fileSizeBytes      BigInt
  durationSeconds    Float
  width              Int
  height             Int
  frameRate          Float
  errorMessage       String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  clips              Clip[]
  contentDraft       ContentDraft?
  audioTracks        AudioTrack[]
  transcriptionJobs  TranscriptionJob[]

  @@index([createdAt])
}

model AudioTrack {
  id                String             @id @default(cuid())
  projectId         String
  project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  streamIndex       Int
  codecName         String
  channels          Int
  channelLayout     String?
  language          String?
  title             String?
  isDefault         Boolean            @default(false)
  preferenceScore   Int                @default(0)
  preferenceReason  String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  transcriptionJobs TranscriptionJob[]

  @@unique([projectId, streamIndex])
  @@index([projectId, streamIndex])
}

model TranscriptionJob {
  id                String              @id @default(cuid())
  projectId         String
  project           Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  audioTrackId      String
  audioTrack        AudioTrack          @relation(fields: [audioTrackId], references: [id], onDelete: Cascade)
  status            TranscriptionStatus @default(QUEUED)
  progress          Int                 @default(0)
  stage             String              @default("Waiting to start")
  provider          String              @default("whisper.cpp")
  modelName         String              @default("base.en")
  errorMessage      String?
  startedAt         DateTime?
  completedAt       DateTime?
  cancelRequestedAt DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  segments          TranscriptSegment[]

  @@index([projectId, createdAt])
  @@index([status])
}

model TranscriptSegment {
  id           String           @id @default(cuid())
  jobId        String
  job          TranscriptionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  segmentOrder Int
  startSeconds Float
  endSeconds   Float
  text         String
  originalText String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([jobId, segmentOrder])
  @@index([jobId, startSeconds])
}

model Clip {
  id              String     @id @default(cuid())
  projectId       String
  project         Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name            String
  status          ClipStatus @default(PROCESSING)
  startSeconds    Float
  endSeconds      Float
  durationSeconds Float
  relativePath    String?    @unique
  fileSizeBytes   BigInt?
  errorMessage    String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([projectId, createdAt])
}

model ContentDraft {
  id                  String   @id @default(cuid())
  projectId           String   @unique
  project             Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  voiceoverScript     String   @default("")
  openingHook         String   @default("")
  youtubeTitle        String   @default("")
  shortFormCaption    String   @default("")
  thumbnailText       String   @default("")
  editingInstructions String   @default("")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}
