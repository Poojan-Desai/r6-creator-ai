# Leave this unchanged to keep recordings, clips, and the database in ./data.
R6_DATA_DIR="./data"

# Prisma uses this while creating local migrations. Keep it relative to prisma/.
DATABASE_URL="file:../data/r6-creator.db"

# Maximum accepted upload size in bytes. Default: 20 GiB.
R6_MAX_UPLOAD_BYTES="21474836480"

# Maximum local voiceover or licensed-music upload size. Default: 1 GiB.
R6_MAX_STUDIO_AUDIO_BYTES="1073741824"

# Optional absolute paths. The bundled FFmpeg tools are used when left blank.
FFMPEG_PATH=""
FFPROBE_PATH=""

# Optional font used for local FFmpeg text/caption rendering.
R6_FONT_PATH=""

# Optional local speech overrides. The default setup script fills these needs.
WHISPER_CLI_PATH=""
WHISPER_MODEL_PATH=""
WHISPER_MODEL_NAME="base.en"

# Optional absolute override for the reviewed local Match Replay parser.
# Leave blank after running `npm run replay:setup`.
R6_DISSECT_PATH=""

# Optional. Enables permitted public YouTube metadata through the official
# YouTube Data API. The key stays on the server. YouTube embeds and manual
# metadata continue working when this is blank.
YOUTUBE_DATA_API_KEY=""

# Optional cloud writing provider. Local generation remains the default and
# works without any key. Cloud writing is disabled until both a key and a
# positive monthly budget are configured, and every request still requires
# explicit in-app consent.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.6-luna"
OPENAI_TIMEOUT_MS="30000"
OPENAI_MAX_RETRIES="0"
# Paid writing requests are never retried automatically to avoid duplicate charges.
OPENAI_MAX_OUTPUT_TOKENS="2000"
OPENAI_MONTHLY_BUDGET_CENTS="0"
OPENAI_PROJECT_MONTHLY_REQUEST_LIMIT="10"
# Keep these aligned with the configured model's current published pricing.
OPENAI_INPUT_USD_PER_MILLION_TOKENS="0.20"
OPENAI_OUTPUT_USD_PER_MILLION_TOKENS="1.20"
